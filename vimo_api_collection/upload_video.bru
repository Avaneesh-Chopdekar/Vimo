meta {
  name: upload_video
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/v1/upload
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  file: @file(/home/avaneesh/Videos/Happy Diwali Python Turtle.mp4)
  title: Happy Diwali
  description: Made using python turtle
}

settings {
  encodeUrl: true
  timeout: 0
}
